# XR Cloud — example environment. Copy to `.env` and fill in.
# Every value here is validated at boot by src/env.ts; a partial group refuses to start.

# ---- core -------------------------------------------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# Public origin of THIS service (used in emails and the licence `iss` claim).
API_URL=http://localhost:8787
# Public origin of the marketing site + admin console. The ONLY allowed CORS origin.
APP_URL=http://localhost:3000

# ---- database ---------------------------------------------------------------
# Leave DATABASE_URL empty and set DATABASE_DRIVER=pglite for a zero-infra dev loop.
# pglite is refused in production by design.
DATABASE_DRIVER=pglite
PGLITE_DIR=.xr-cloud-pglite
# DATABASE_URL=postgres://xr:xr@localhost:5432/xr_cloud

# ---- cache / rate limiting --------------------------------------------------
# Optional. Without it, rate limits are per-process — correct for one instance,
# wrong behind a load balancer. /readyz says which one is live.
# REDIS_URL=redis://localhost:6379

# ---- sessions ---------------------------------------------------------------
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-replace-me-with-48-random-bytes
# SESSION_ACCESS_TTL_SECONDS=900
# SESSION_REFRESH_TTL_DAYS=30
# COOKIE_DOMAIN=api.xr.rrrtx.ai

# ---- encryption -------------------------------------------------------------
# base64 of exactly 32 bytes. Wraps every organization key. NEVER rotate silently.
# Generate: openssl rand -base64 32
#
# Deliberately left empty. A value in this file — even a throwaway one — is
# public the moment it is committed, and this file exists to be copied. The
# service refuses to boot without a real key rather than falling back to a
# known one, so the failure tells you to generate one instead of hiding it.
XR_KEY_ENCRYPTION_KEY=

# ---- licence signing --------------------------------------------------------
# Ed25519 PKCS#8, base64. Generate with: bun run license:keypair
# XR_LICENSE_PRIVATE_KEY=
XR_LICENSE_KID=xr-lic-1

# ---- stripe (optional) ------------------------------------------------------
# Absent => every billing route answers 503 with a repair string. Teams, SSO,
# team memory and audit all work without it.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO_SEAT_MONTHLY=price_...
# STRIPE_PRICE_ID_PRO_SEAT_ANNUAL=price_...

# ---- object storage (optional) ---------------------------------------------
# Absent => audit exports are written to a local directory and downloaded through
# an authenticated route instead of a pre-signed URL.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=xr-exports
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---- email ------------------------------------------------------------------
# `capture` writes .eml files to MAIL_CAPTURE_DIR — the default in development so
# sign-up and sign-in are testable with no mail server.
MAIL_TRANSPORT=capture
MAIL_FROM="XR <no-reply@xr.rrrtx.ai>"
MAIL_CAPTURE_DIR=.xr-cloud-mail
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ---- operations -------------------------------------------------------------
LOG_LEVEL=info
# Only set this when a reverse proxy really is in front. Trusting X-Forwarded-For
# without one lets a caller spoof their way past every IP rate limit.
TRUST_PROXY=0

# ---- trials -----------------------------------------------------------------
TRIAL_DAYS=30
TRIAL_MAX_SEATS=5
