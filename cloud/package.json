{
  "name": "@rrrtx/xr-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "XR Cloud — the Business-tier account, team, SSO, billing, team-memory and audit service. Separate deployable; never a dependency of the local XR runtime.",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "license:keypair": "bun run scripts/mint-license-keypair.ts",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.0",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.2",
    "samlify": "^2.13.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
