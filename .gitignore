# Dependencies (installed by `bun install` / CI)
node_modules/

# Bun local state
.bun/

# Built binary
xr-bin

# Build output
dist/
build/
out/

# TypeScript incremental state
*.tsbuildinfo

# Test / coverage artifacts
coverage/
*.log

# XR local runtime state (databases, workspaces, secrets)
.xr/
*.db
*.db-shm
*.db-wal

# Environment files (secrets)
# Glob-based so a new variant (.env.production, .env.staging.local, …) is
# ignored by default rather than one commit away from being published.
.env
.env.*
!.env.example
!.env.sample

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
*.sublime-*
.vscode/
.idea/

# Temp files
*.tmp
*.bak
*.orig
mutation-report.json
xr-audit-*.md
test/perf/.seed/
# Phase 8 · T4: raw SUS responses are local-only (study aggregate lives in docs/ux/SUS.md)
docs/ux/sus-results.local.jsonl

# Tauri build artifacts (desktop)
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/
desktop/src-tauri/binaries/

# Vite's dependency cache (regenerated; never committed)
.vite/

# The desktop app pins its dependency graph with bun.lock — a package-lock.json
# produced by a local `npm install` is an artifact of that machine, not a source
# of truth, and two lockfiles in one package drift.
desktop/package-lock.json
desktop/node_modules
desktop/dist
audit*.mjs
