# XR — environment reference (example values; never commit a real secret)
#
# Copy to `.env` and fill in what you need. Everything here is optional: XR runs
# fully locally with none of it set, on local model runtimes or your own provider
# keys. Nothing in this file is required for the desktop application, the CLI, the
# mobile PWA or any local feature — that is the whole design, not a convenience.
#
# The cloud control plane has its own, larger reference at `cloud/.env.example`.
# The values below are the ones the DESKTOP/daemon reads to talk to it.

# ─── Provider keys (BYOK — free on every tier, direct to the provider) ──────
# Set whichever you use. Keys are read from the environment or the OS secret
# store; they are never written to a config file and never sent to XR.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ─── Local providers ────────────────────────────────────────────────────────
# Optional overrides for local runtimes (Ollama, LM Studio, llama.cpp, …).
# OLLAMA_HOST=http://127.0.0.1:11434

# ─── Business tier (all optional; see docs/business/BILLING.md) ─────────────

# Where the hosted control plane lives, for `xr cloud …` and the desktop's
# "Billing & Account" panel. Leave unset and XR never makes a cloud request —
# not even a discovery one.
# XR_CLOUD_API_URL=https://api.xr.rrrtx.ai

# The team session token, as stored by the daemon in the OS secret store under
# this name. Shown here only so the name is documented; the CLI writes it, and
# nothing reads it from a file. Never put a real token in `.env`.
# XR_CLOUD_SESSION=

# The signed Business licence (EdDSA JWT). Verified OFFLINE against the public key
# compiled into the binary — there is no licence server, no heartbeat and no
# remote disable. Set it only to install a licence by hand; normally the daemon
# fetches one when you sign in.
# XR_CLOUD_LICENSE=

# Override the built-in licence verification key. For two honest cases: a
# self-hosted control plane that mints its own licences, and the test suite.
# XR_LICENSE_PUBLIC_KEY_SPKI=

# Not a client value. The control plane's Ed25519 PRIVATE key, used to mint
# licences (`bun run license:keypair` in `cloud/`). Documented here only so that
# anyone grepping the repository finds it with its scope attached: it belongs to
# the server, and a build that ships it is a build that has been compromised.
# XR_LICENSE_PRIVATE_KEY=

# ─── Daemon / engine ────────────────────────────────────────────────────────

# Root for XR's local state (SQLite database, workspaces, logs). Defaults to
# ~/.xr.
# XR_HOME=

# Bearer token the desktop shell presents to the local daemon. Generated on first
# run. Localhost-only; it is not a cloud credential.
# XR_DAEMON_TOKEN=

# Emit the Business OS extension routes (/api/business/*). OFF by default and
# unrelated to the paid tier — that extension is a local, MIT-licensed work
# queue/approvals surface (ADR-0028), not a billing feature.
# XR_BUSINESS_ROUTES=off

# Log verbosity: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
