<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for XR Desktop (Phase 27).

  Tauri 2.12 has no `msix` bundle target (see docs/release/SUPPORT_MATRIX.md), so
  this manifest plus packaging/windows/msix/build-msix.ps1 is the packaging path
  instead of a config flag: the NSIS/MSI installers are built by `tauri build` as
  usual, the release app directory is wrapped into an MSIX around them.

  Identity is fixed here on purpose — a Store or enterprise deployment pins the
  package identity, and changing it later makes every existing install a
  different app. Publisher must match the signing certificate's subject exactly
  or the package will not install (`Publisher` is compared, not just recorded).

  Signing: the CI job signs with a self-signed test certificate and publishes the
  .cer beside the .msix so a tester can trust it explicitly. Store submission and
  the real certificate are operator steps and explicitly out of scope for the
  phase brief.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="XRrrrtx.XRDesktop"
    Publisher="CN=Muhammad Ahmad, O=Muhammad Ahmad, C=PK"
    Version="0.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>XR</DisplayName>
    <PublisherDisplayName>Muhammad Ahmad</PublisherDisplayName>
    <Description>XR — the AI agent you can actually trust. Runs on your machine.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="XRDesktop" Executable="xr-desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="XR"
        Description="Local-first AI agent with audited trust"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- xr:// deep links, the same scheme the deep-link plugin owns at runtime. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="xr">
            <uap:DisplayName>XR link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Toast activation: the shell shows OS notifications when hidden, and
             clicking one has to come back to the running app rather than
             launching a second copy (W-3 single-instance still applies).

             There is deliberately no `desktop:Extension
             Category="windows.appUserModelId"` here. That value is not in the
             schema's Category enumeration, and MakeAppx rejects the entire
             manifest for it — "Package creation failed", with the real cause
             buried in a schema line reference. A Windows.FullTrustApplication
             does not need to declare one: its AppUserModelID is derived from
             the package family name plus the Application Id. -->
        <uap:Extension Category="windows.toastNotificationActivation">
          <uap:ToastNotificationActivation ToastActivatorCLSID="3f2b8c1e-9a44-4d0e-9a6f-6d1c4a2b7e10" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The engine runs locally and binds loopback; the shell needs outbound
         HTTPS for model providers and the update channel. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
