#!/usr/bin/env node
// XR npm launcher (Node 20+). Prefer an explicit/prebuilt XR binary, then the
// pinned Bun platform package installed with XR. No postinstall script or
// runtime download is performed here. A system Bun remains a warned fallback
// for contributors and installations whose optional dependency was omitted.
import { spawn, spawnSync } from "node:child_process";
import { existsSync } from "node:fs";
import { constants as osConstants } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { compiledBinaryName, locateBundledRuntime } from "./bun-runtime.js";

const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const entry = join(ROOT, "src", "index.ts");

function compiledBinary() {
  // An explicitly set XR_BINARY replaces the default candidate, even if the
  // explicit path is missing. This preserves the launcher's prior behavior.
  const candidate = process.env.XR_BINARY ?? join(ROOT, "dist", compiledBinaryName(process.platform, process.arch));
  return existsSync(candidate) ? candidate : null;
}

function which(cmd) {
  const probe = process.platform === "win32" ? "where" : "command";
  const args = process.platform === "win32" ? [cmd] : ["-v", cmd];
  const lookup = spawnSync(probe, args, { encoding: "utf8", shell: process.platform !== "win32" });
  if (lookup.status !== 0 || !lookup.stdout) return null;
  return lookup.stdout.split(/\r?\n/).map((s) => s.trim()).find(Boolean) || null;
}

function runSource(bun) {
  if (!existsSync(entry)) {
    console.error(`XR entrypoint not found: ${entry}`);
    process.exitCode = 1;
    return;
  }
  run(bun, ["run", entry, ...process.argv.slice(2)]);
}

function run(file, args) {
  const child = spawn(file, args, { stdio: "inherit" });
  // A terminal Ctrl+C already reaches both processes in the foreground group.
  // Forwarding that SIGINT again can turn one interrupt into two. For a TTY,
  // rely on the terminal for SIGINT; a signal addressed only to the launcher
  // while it has a TTY is therefore not relayed. Non-TTY supervisor signals
  // and termination/hangup signals are forwarded to the child.
  const handlers = new Map();
  for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
    const forward = () => {
      if (signal === "SIGINT" && process.stdin.isTTY) return;
      try { child.kill(signal); } catch { /* child already exited */ }
    };
    handlers.set(signal, forward);
    process.on(signal, forward);
  }
  const cleanup = () => { for (const [signal, handler] of handlers) process.off(signal, handler); };
  child.once("error", (error) => {
    cleanup();
    console.error(`XR could not start ${file}: ${error.message}`);
    process.exit(error.code === "ENOENT" ? 127 : 1);
  });
  child.once("exit", (status, signal) => {
    cleanup();
    // Follow the conventional shell exit status for a signal-terminated child.
    process.exit(signal ? 128 + (osConstants.signals[signal] ?? 1) : (status ?? 1));
  });
}

function main() {
  const binary = compiledBinary();
  if (binary) return run(binary, process.argv.slice(2));

  const bundled = locateBundledRuntime(ROOT);
  if (bundled.status === "found") return runSource(bundled.exe);
  if (bundled.status === "invalid") {
    console.error(`XR's bundled Bun runtime is invalid: ${bundled.detail}. Reinstall XR with optional dependencies enabled.`);
    process.exitCode = 1;
    return;
  }

  const bun = which(process.platform === "win32" ? "bun.exe" : "bun") ?? which("bun");
  if (bun) {
    const reason = bundled.status === "missing" ? `${bundled.name}@${bundled.expected} is not installed` : bundled.detail;
    console.error(`XR warning: ${reason}; using Bun from PATH instead of XR's pinned runtime.`);
    return runSource(bun);
  }

  const reason = bundled.status === "missing"
    ? `The optional runtime package ${bundled.name}@${bundled.expected} is not installed.`
    : bundled.detail;
  console.error(`\n  XR could not find a usable Bun runtime. ${reason}\n\n  Reinstall XR with npm optional dependencies enabled (do not use --omit=optional).\n  Installation scripts are not required. For an unsupported platform or a\n  source checkout, an independently installed Bun on PATH can be used instead.\n`);
  process.exitCode = 127;
}

main();
