#!/usr/bin/env node
/**
 * XR — universal launcher (plain ESM JavaScript: runs under Node 18+ AND Bun).
 *
 * Distribution paths, in order:
 *
 *   1. Compiled binary (default distribution path): when dist/<platform>
 *      contains the standalone binary (installed by install.sh / install.ps1
 *      / the release pipeline, or by `xr update`), exec it — one process,
 *      no runtime download, no spawn tax.
 *
 *   2. Bun from source (contributor / npm path): the CLI runs from TypeScript
 *      sources, which requires Bun. If Bun is installed we run it via
 *      `bun run` (single child, stdio inherited).
 *
 *   3. No Bun: print the exact one-line fix and exit 127 — never a cryptic
 *      `env: bun: No such file or directory` (audit P0-1).
 *
 * XR_BINARY env override always wins (documented power-user escape hatch).
 */

import { spawnSync } from "node:child_process";
import { existsSync } from "node:fs";
import { join, dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
const ROOT = resolve(HERE, "..");

function binaryFileName() {
  const map = {
    "linux-x64": "xr-linux-x64",
    "linux-arm64": "xr-linux-arm64",
    "darwin-arm64": "xr-darwin-arm64",
    "darwin-x64": "xr-darwin-x64",
    "win32-x64": "xr-windows-x64.exe",
  };
  const key = `${process.platform}-${process.arch}`;
  return map[key] ?? `xr-${process.platform}-${process.arch}`;
}

function which(cmd) {
  const probe = process.platform === "win32" ? "where" : "command";
  const args = process.platform === "win32" ? [cmd] : ["-v", cmd];
  const res = spawnSync(probe, args, { encoding: "utf8", shell: process.platform !== "win32" });
  if (res.status !== 0 || !res.stdout) return null;
  return res.stdout.split(/\r?\n/).map((s) => s.trim()).find(Boolean) || null;
}

function main() {
  const argv = process.argv.slice(2);

  // 1. Compiled binary (default distribution path).
  const binary = process.env.XR_BINARY ?? join(ROOT, "dist", binaryFileName());
  if (existsSync(binary)) {
    const res = spawnSync(binary, argv, { stdio: "inherit", env: process.env });
    process.exit(res.status === null ? 1 : res.status);
    return;
  }

  // 2. Bun from source (npm / contributor path).
  const bun = which(process.platform === "win32" ? "bun.exe" : "bun") ?? which("bun");
  if (bun) {
    const entry = join(ROOT, "src", "index.ts");
    if (!existsSync(entry)) {
      console.error(`XR entrypoint not found: ${entry}`);
      process.exit(1);
    }
    const res = spawnSync(bun, ["run", entry, ...argv], { stdio: "inherit", env: process.env });
    process.exit(res.status === null ? 1 : res.status);
    return;
  }

  // 3. No Bun — actionable message, not a crash.
  console.error("");
  console.error("  XR needs the Bun runtime to run from source.");
  console.error("");
  console.error("  Install it (one line), then run xr again:");
  console.error("");
  if (process.platform === "win32") {
    console.error('    powershell -c "irm bun.sh/install.ps1 | iex"');
  } else {
    console.error("    curl -fsSL https://bun.sh/install | bash");
  }
  console.error("");
  console.error("  (Or install the compiled binary channel, which needs no runtime:");
  console.error("   https://github.com/ahmadrrrtx/xr#install )");
  console.error("");
  process.exit(127);
}

main();
