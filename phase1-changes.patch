+      status: "pending", reviewState: "none", approvalState: "none",
+      dependencies: [], createdAt: Date.now(), updatedAt: Date.now() },
+  ],
+  createdAt: Date.now(), updatedAt: Date.now(),
+} as never);
+store.close();
