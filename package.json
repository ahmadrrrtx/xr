{
  "name": "@rrrtx/xr",
  "version": "7.0.1",
  "description": "XR — a local-first, provider-neutral AI agent runtime. BYOK, spend-capped, tamper-evident audit, plugin/MCP extensibility.",
  "type": "module",
  "bin": {
    "xr": "./bin/xr"
  },
  "files": [
    "bin",
    "src",
    "plugins",
    "skills",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "ci": "bun run typecheck && bun test && bun run release:check && bun run claim-lint && bun run baseline:inventory && bun run boundaries && bun run size-gate && bun run hot-path-lint",
    "xr": "bun run src/index.ts",
    "cli:help": "bun run src/index.ts help",
    "cli:doctor": "bun run src/index.ts doctor",
    "prepublishOnly": "bun run release:check && bun run claim-lint",
    "baseline:inventory": "bun run scripts/baseline-inventory.ts",
    "baseline:measure": "bun run scripts/measure-baseline.ts",
    "baseline:validate": "bun run scripts/validate-baseline.ts",
    "release:stamp": "bun run scripts/release-manifest.ts --write",
    "release:check": "bun run scripts/release-manifest.ts --check",
    "claim-lint": "bun run scripts/claim-lint.ts",
    "mutation:run": "bun run scripts/mutate.ts --threshold 0.6",
    "golden-path": "bun run scripts/golden-path.ts",
    "reliability:test": "bun test test/reliability/",
    "boundaries": "bun ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config .dependency-cruiser.cjs --output-type err-long src",
    "boundaries:graph": "bun ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config .dependency-cruiser.cjs --output-type dot src",
    "size-gate": "bun run scripts/size-gate.ts",
    "build:binary": "bun run scripts/build-matrix.ts",
    "build:binary:local": "bun run scripts/build-matrix.ts --targets $(node -e 'console.log(process.platform+\"-\"+process.arch)')",
    "perf:baseline": "bun run scripts/perf-baseline.ts",
    "perf:gate": "bun run scripts/perf-gate.ts",
    "hot-path-lint": "bun run scripts/hot-path-lint.ts",
    "sbom": "bun run scripts/sbom.ts",
    "supply:check": "bun run scripts/license-check.ts && bun run scripts/sbom.ts --out /tmp/xr-sbom.json",
    "verify-release": "bun run scripts/verify-release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadrrrtx/xr.git"
  },
  "bugs": {
    "url": "https://github.com/ahmadrrrtx/xr/issues"
  },
  "homepage": "https://xr-gules.vercel.app",
  "keywords": [
    "ai-agent",
    "ai-os",
    "byok",
    "local-llm",
    "ollama",
    "prompt-injection",
    "secure-agent",
    "cli",
    "rrtx"
  ],
  "author": "Muhammad Ahmad (@ahmadrrrtx)",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dependency-cruiser": "^17.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}