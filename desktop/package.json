{
  "name": "@rrrtx/xr-desktop",
  "version": "0.2.0-phase0",
  "private": true,
  "type": "module",
  "description": "XR Desktop — the AI agent you can actually trust. Tauri v2 + React 18 + Tailwind v4 shell.",
  "scripts": {
    "dev": "vite",
    "engine": "bun run scripts/dev-engine.ts",
    "dev:tauri": "bun run ../scripts/compile-sidecar.ts --if-missing && tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "bun run ../scripts/compile-sidecar.ts && tauri build",
    "sidecar": "bun run ../scripts/compile-sidecar.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri"
  },
