{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XR Desktop",
  "version": "0.1.0",
  "identifier": "ai.rrrtx.xr-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XR \u2014 Workstation",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "XR \u2014 the AI agent you can actually trust, with a desk to work at",
    "longDescription": "XR Desktop is a local-first, provider-neutral AI workstation: talk, task, code, research, control and automate with audited trust.",
    "externalBin": [
      "binaries/xr-engine"
    ]
  }
}
